# Configurações de Integração Asaas
# Obtenha sua chave de API em: https://www.asaas.com (Configurações da Conta > Integrações > Chaves de API)

# Chave de API Asaas (começa com $aact_...)
ASAAS_API_KEY=

# Ambiente: 'sandbox' para testes ou 'production' para pagamentos reais
ASAAS_ENVIRONMENT=sandbox

# Porta do Servidor (Padrão: 3000)
PORT=3000


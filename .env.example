# =======================================================
# 🎄 CONFIGURAÇÃO DA API ASAAS & PIX - NATAL DE ESPERANÇA
# =======================================================

# 1. Chave de API do Asaas (Access Token)
ASAAS_API_KEY=

# 2. Ambiente Asaas ("sandbox" ou "production")
ASAAS_ENVIRONMENT=production

# 3. Porta do Servidor Local
PORT=3000

# 4. Dados da Paróquia
PARISH_PIX_KEY=pix@igrejacomunidade.org.br
PARISH_NAME=Paroquia da Comunidade
PARISH_CITY=SAO PAULO

# =======================================================
# 🔥 GOOGLE CLOUD & FIREBASE FIRESTORE (TEMPO REAL)
# =======================================================
# Backend (Firebase Admin SDK / Firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=backend/serviceAccountKey.json

# Frontend (Firebase Web Client para sincronização de tela ao vivo)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
